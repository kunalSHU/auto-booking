# This file serves as a template for the required environment variables.
# For local development, copy this file to .env and replace the placeholder
# values with your actual credentials.

# --- PostgreSQL Database ---
DB_USER=postgres
DB_PASSWORD=your_local_db_password
DB_NAME=auto_booking
DB_HOST=localhost

# --- Redis Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ACCESS_KEY=YOUR_REDIS_ACCESS_KEY_HERE

# --- AWS Services (e.g., for S3) ---
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_REGION=us-east-1

# --- Third-Party APIs ---
OPENAI_KEY=YOUR_OPENAI_API_KEY_HERE

# --- Frontend Variables ---
# These variables are exposed to the React frontend and MUST be prefixed with REACT_APP_.
REACT_APP_API_MAPS_TOKEN=YOUR_GOOGLE_MAPS_API_TOKEN_HERE